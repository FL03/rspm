#!/usr/bin/env bash
# pre-push — dispatch to open-sprint-pr.
#
# WHY THIS FILE EXISTS. `.githooks/open-sprint-pr` was tracked, executable, and
# never ran: `core.hooksPath` was unset, so git looked in `.git/hooks/` (samples
# only), and even pointed at `.githooks/` the name `open-sprint-pr` is not a git
# hook name. Git has a fixed vocabulary of hook filenames; anything else is an
# inert script sitting in a hooks directory. So the repo carried a hook-shaped
# file that no git operation could ever invoke.
#
# WHY pre-push AND NOT pre-commit. open-sprint-pr requires the branch to already
# exist on the remote -- it calls `git ls-remote --exit-code --heads` at :61 and
# exits early when the branch is absent. A pre-commit hook runs before any push
# has happened, so on a fresh sprint branch it would take that early exit every
# time and never open anything. It also shells out to `gh api` over the network,
# which is the wrong cost to pay on every commit.
#
# pre-push is the only client-side push hook git offers. Running open-sprint-pr
# here means: first push creates the branch remotely and the hook takes its
# early exit; every subsequent push finds the branch and opens the draft PR if
# one is not already open. That is one push of latency, and it is the closest
# git gets to "after push" without a server-side hook.
#
# NOT ENABLED BY DEFAULT. This file does nothing until someone sets
#   git config core.hooksPath .githooks
# which is LOCAL config and cannot be committed. That is deliberate: turning it
# on causes an outward-facing action (opening a PR on GitHub), so it is the
# operator's switch to throw, not something a clone silently inherits.
#
# There is deliberately NO test-running pre-commit hook in this repo. Gate tests
# run at step boundaries and before pushes -- see AGENTS.md.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPRINT_PR="$HOOK_DIR/open-sprint-pr"

[ -x "$SPRINT_PR" ] || exit 0

# Never let PR bookkeeping block a push. open-sprint-pr exits 1 on a genuine
# GitHub API failure, and a failed `gh api` call is not a reason to refuse to
# publish commits -- the push is the thing that matters, the draft PR is
# convenience. Report the failure, exit 0.
if ! "$SPRINT_PR" "$@"; then
  echo "pre-push: open-sprint-pr failed; push continues (PR bookkeeping is not a gate)." >&2
fi
exit 0
